# The WARP container will not register until this is explicitly set to yes.
# By doing so you confirm that you accept Cloudflare's applicable WARP terms.
WARP_ACCEPT_TOS=yes

# Host port for the combined WARP + Mirror stack.
MIRROR_PORT=8799

# Optional Mirror application API key(s), not OpenAI credentials.
MIRROR_API_KEY=
MIRROR_API_KEYS=
# Optional additional inbound Mirror key for OpenAI-compatible clients.
OPENAI_API_KEY=

# Optional fixed 32-byte key (base64 or 64 hex chars). If omitted, the
# persistent mirror-data volume receives a generated key.
MIRROR_STORE_KEY=
